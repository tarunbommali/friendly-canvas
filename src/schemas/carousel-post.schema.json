{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swe-notebook.local/schemas/carousel-post.schema.json",
  "title": "SWE Notebook Carousel Post",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "title",
    "collection",
    "slides",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "object",
      "required": [
        "id",
        "name",
        "palette"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "palette": {
          "type": "object",
          "required": [
            "primary",
            "accent"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slideNo",
          "layout",
          "content",
          "config",
          "elements",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slideNo": {
            "type": "integer",
            "minimum": 1
          },
          "layout": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "content": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "visualDirective": {
                "type": "string"
              },
              "insight": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "leftTitle": {
                "type": "string"
              },
              "leftContent": {
                "type": "string"
              },
              "rightTitle": {
                "type": "string"
              },
              "rightContent": {
                "type": "string"
              },
              "watermark": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "config": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "background": {
                "type": "string"
              },
              "backgroundType": {
                "type": "string"
              },
              "padding": {
                "type": "number"
              },
              "spacing": {
                "type": "number"
              }
            },
            "additionalProperties": true
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "x",
                "y",
                "width",
                "height",
                "zIndex"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "headline",
                    "text",
                    "image",
                    "shape",
                    "icon",
                    "logo",
                    "badge",
                    "container"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "zIndex": {
                  "type": "integer"
                },
                "content": {
                  "type": "string"
                },
                "font": {
                  "type": "object"
                },
                "style": {
                  "type": "object"
                },
                "align": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "label"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "enum": [
                    "taxonomy",
                    "custom",
                    "url"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedAudio": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
